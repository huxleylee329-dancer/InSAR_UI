/* Global font and base styling - application.qss */
* {
    font-family: "Segoe UI", "Microsoft YaHei", Arial, sans-serif;
    font-size: 9pt;
}

QMainWindow {
    background-color: #F9F9F9;
}

QStatusBar {
    background-color: #F0F0F0;
    border-top: 1px solid #CCCCCC;
}

QMenuBar {
    background-color: #F9F9F9;
    border-bottom: 1px solid #CCCCCC;
}

QMenuBar::item {
    padding: 4px 12px;
}

QMenuBar::item:selected:enabled {
    background-color: #005FAC;
    color: white;
}

QMenuBar::item:selected:disabled {
    background-color: transparent;
    color: #999999;
}

QMenuBar::item:disabled {
    color: #999999;
}

/* Checked menu item styling */
QMenu {
    background-color: white;
    color: #333333;
    border: 1px solid #CCCCCC;
}

QMenu::icon {
    margin-left: 10px;
}

QMenu::item {
    padding: 6px 24px 6px 38px;
    background-color: transparent;
}

QMenu::item:disabled {
    color: #999999;
}

QMenu::item:selected:enabled {
    background-color: #005FAC;
    color: white;
}

QMenu::item:selected:disabled {
    background-color: transparent;
    color: #999999;
}

QMenu::item:checked {
    background-color: #E6F0FA;
    color: #005FAC;
}

QToolBar {
    background-color: #F0F0F0;
    border-bottom: 1px solid #CCCCCC;
    spacing: 3px;
}

QSplitter::handle {
    background-color: #E0E0E0;
}

QSplitter::handle:hover {
    background-color: #005FAC;
}

/* TreeView branch indicator styling (Light Theme) */
QTreeView::branch:has-children:closed:has-siblings,
QTreeView::branch:has-children:closed {
    border-image: none;
    image: url(:/SatExplorer/svg/chevron_right_light.svg);
}

QTreeView::branch:open:has-children:has-siblings,
QTreeView::branch:open:has-children {
    border-image: none;
    image: url(:/SatExplorer/svg/chevron_down_light.svg);
}
