/* MainWindow specific styling - mainwindow.qss */

MainWindow {
    background-color: #F9F9F9;
}

MainWindow #treeView {
    background-color: white;
    border: none;
}

MainWindow #tabWidget {
    background-color: white;
}

MainWindow #Process {  /* QProgressBar */
    min-height: 24px;
}

/* Project tree styling */
MainWindow QTreeView {
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    show-decoration-selected: 1;
}

MainWindow QTreeView::item {
    padding: 4px;
}
