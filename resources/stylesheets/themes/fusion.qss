/* Fusion theme - flat, modern, primary color emphasis - themes/fusion.qss */

/* Note editor in fusion theme */
QTextEdit#noteTextEdit {
    background-color: #FFF9C4;
    color: #333333;
    border: 1px solid #FFC107;
    border-radius: 4px;
    padding: 4px;
}

/* Toolbar */
QToolBar QToolButton {
    color: #333333;
}

QPushButton {
    border-radius: 2px;
    background-color: #005FAC;
    color: white;
    font-weight: bold;
    border: none;
    padding: 8px 16px;
}

QPushButton:hover {
    background-color: #107EBC;
}

QPushButton:pressed {
    background-color: #003F8C;
}

QPushButton:disabled {
    background-color: #E0E0E0;
    color: #AAAAAA;
}

QLineEdit {
    background-color: white;
    border: 1px solid #E0E0E0;
    border-radius: 2px;
    padding: 6px 10px;
}

QLineEdit:focus {
    border-color: #005FAC;
    border-width: 2px;
}

QComboBox {
    background-color: white;
    border: 1px solid #E0E0E0;
    border-radius: 2px;
    padding: 6px 10px;
}

QComboBox:hover {
    border-color: #005FAC;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #E0E0E0;
    border-radius: 2px;
}

QCheckBox::indicator:checked {
    background-color: #005FAC;
    border: none;
}

QTabBar::tab {
    background-color: #F0F0F0;
    color: #666666;
    border-radius: 2px 2px 0 0;
    border: none;
    padding: 10px 20px;
}

QTabBar::tab:selected {
    background-color: #005FAC;
    color: white;
}

QProgressBar {
    border: none;
    border-radius: 2px;
    background-color: #E0E0E0;
}

QProgressBar::chunk {
    background-color: #005FAC;
    border-radius: 2px;
}

/* Tree styling */
QTreeView {
    background-color: white;
    color: #333333;
    border: 1px solid #E0E0E0;
}

QTreeView QHeaderView::section {
    background-color: #F0F0F0;
    color: #333333;
    border: 1px solid #E0E0E0;
}

QTreeView::item:selected {
    background-color: #005FAC;
    color: white;
}

QTreeWidget {
    border: none;
    alternate-background-color: #F9F9F9;
}

QTreeWidget::item:selected {
    background-color: #005FAC;
    color: white;
}

/* Group styling */
QGroupBox {
    border: 2px solid #E0E0E0;
    border-radius: 6px;
    margin-top: 12px;
    font-weight: bold;
}

QGroupBox::title {
    color: #005FAC;
}

/* Tab close button */
#tabCloseButton {
    background-color: transparent;
    border: none;
    padding: 0px;
    min-width: 16px;
    max-width: 16px;
    min-height: 16px;
    max-height: 16px;
}

#tabCloseButton:hover {
    background-color: #505050;
}

#tabCloseButton QPushButton {
    border: none;
    padding: 0px;
}

#tabCloseButton QPushButton::menu-indicator {
    width: 0px;
}

/* Property Editor for Fusion theme */
PropertyEditor {
    background-color: #F0F0F0;
}

PropertyEditor QLabel {
    color: #333333;
}

PropertyEditor QLineEdit {
    background-color: white;
    color: #333333;
    border: 1px solid #E0E0E0;
    border-radius: 2px;
    padding: 6px 10px;
}

PropertyEditor QLineEdit:focus {
    border-color: #005FAC;
    border-width: 2px;
}

PropertyEditor QDoubleSpinBox {
    background-color: white;
    color: #333333;
    border: 1px solid #E0E0E0;
}

PropertyEditor QComboBox {
    background-color: white;
    color: #333333;
    border: 1px solid #E0E0E0;
}

PropertyEditor QSpinBox {
    background-color: white;
    color: #333333;
    border: 1px solid #E0E0E0;
}

PropertyEditor QCheckBox {
    color: #333333;
}

PropertyEditor QFrame[frameShape="4"] { /* HLine */
    background-color: #CCCCCC;
}

/* Node embedded widget (via objectName) - flat style for card layout */
QWidget#NodeEmbeddedWidget {
    background-color: transparent;
}

/* All controls inside node embedded widget */
QWidget#NodeEmbeddedWidget * QLabel {
    color: #333333;
}

QWidget#NodeEmbeddedWidget * QLineEdit {
    background-color: white;
    color: #333333;
    border: 1px solid #E0E0E0;
    border-radius: 2px;
}

QWidget#NodeEmbeddedWidget * QLineEdit:focus {
    border-color: #005FAC;
    border-width: 2px;
}

QWidget#NodeEmbeddedWidget * QComboBox {
    background-color: white;
    color: #333333;
    border: 1px solid #E0E0E0;
    border-radius: 2px;
}

QWidget#NodeEmbeddedWidget * QComboBox QAbstractItemView {
    background-color: white;
    color: #333333;
}

QWidget#NodeEmbeddedWidget * QListWidget {
    background-color: white;
    color: #333333;
}

QWidget#NodeEmbeddedWidget * QProgressBar {
    background-color: white;
    color: #333333;
    border-radius: 2px;
}

QWidget#NodeEmbeddedWidget * QProgressBar::chunk {
    background-color: #005FAC;
    border-radius: 2px;
}

/* QPushButton in nodes - flat style */
QWidget#NodeEmbeddedWidget * QPushButton {
    background-color: #005FAC;
    color: #FFFFFF;
    border: none;
    border-radius: 2px;
}

QWidget#NodeEmbeddedWidget * QPushButton:hover {
    background-color: #107EBC;
}

QWidget#NodeEmbeddedWidget * QPushButton:pressed {
    background-color: #003F8C;
}
