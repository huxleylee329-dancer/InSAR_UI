/* Light theme - minimal overrides, just ensure colors are correct - themes/light.qss */

QMainWindow {
    background-color: #F9F9F9;
}

QTreeView {
    background-color: white;
    color: #005FAC;
}

QTreeView::item:selected {
    background-color: #005FAC;
    color: white;
}

QTreeView::item:hover {
    background-color: #E0E0E0;
}

QTreeView::item:selected:hover {
    background-color: #004b87;
    color: white;
}

QTreeView QHeaderView::section {
    background-color: #f0f0f0;
    color: #333333;
    border: 1px solid #cccccc;
}

QLabel {
    color: #333333;
}

QLineEdit {
    background-color: white;
    color: #333333;
}

QTextEdit {
    background-color: white;
    color: #333333;
}

QPlainTextEdit {
    background-color: white;
    color: #333333;
}

/* Note editor in light theme */
QTextEdit#noteTextEdit {
    background-color: #FFF9C4;
    color: #333333;
    border: 1px solid #FFC107;
    border-radius: 4px;
    padding: 4px;
}

/* Toolbar */
QToolBar QToolButton {
    color: #333333;
}

/* Tab close button */
#tabCloseButton {
    background-color: transparent;
    border: none;
    padding: 0px;
    min-width: 16px;
    max-width: 16px;
    min-height: 16px;
    max-height: 16px;
}

#tabCloseButton:hover {
    background-color: #505050;
}

#tabCloseButton QPushButton {
    border: none;
    padding: 0px;
}

#tabCloseButton QPushButton::menu-indicator {
    width: 0px;
}

/* Node embedded widget (via objectName) - flat style for card layout */
QWidget#NodeEmbeddedWidget {
    background-color: transparent;
}

/* All controls inside node embedded widget */
QWidget#NodeEmbeddedWidget QLabel {
    color: #333333;
}

QWidget#NodeEmbeddedWidget QLabel:disabled {
    color: #999999;
}

QWidget#NodeEmbeddedWidget QLineEdit {
    background-color: white;
    color: #333333;
    border: 1px solid #CCCCCC;
    border-radius: 0;
    padding: 2px 5px;
    min-height: 16px;
    max-height: 16px;
}

QWidget#NodeEmbeddedWidget QLineEdit:disabled {
    background-color: #F5F5F5;
    color: #999999;
    border-color: #DDDDDD;
}

QWidget#NodeEmbeddedWidget QComboBox {
    background-color: white;
    color: #333333;
    border: 1px solid #CCCCCC;
    border-radius: 0;
    padding: 2px 5px;
    min-height: 16px;
    max-height: 16px;
}

QWidget#NodeEmbeddedWidget QComboBox:disabled {
    background-color: #F5F5F5;
    color: #999999;
    border-color: #DDDDDD;
}

QWidget#NodeEmbeddedWidget QComboBox QAbstractItemView {
    background-color: white;
    color: #333333;
}

QWidget#NodeEmbeddedWidget QListWidget {
    background-color: white;
    color: #333333;
}

QTableView, QTableWidget {
    background-color: white;
    color: #333333;
    gridline-color: #CCCCCC;
    border: 1px solid #CCCCCC;
    alternate-background-color: #F9FAFB;
}

QTableView::viewport, QTableWidget::viewport {
    background-color: white;
}

QLabel#NodeStatusLabel {
    color: #6B7280;
    font-style: italic;
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: #005FAC;
    color: white;
}

QHeaderView {
    background-color: #F3F4F6;
    border: none;
}

QHeaderView::section {
    background-color: #F3F4F6;
    color: #4B5563;
    border: 1px solid #E5E7EB;
    padding: 4px;
}

QTableCornerButton::section {
    background-color: #F3F4F6;
    border: 1px solid #E5E7EB;
}

QWidget#NodeEmbeddedWidget QProgressBar {
    background-color: white;
    color: #333333;
    border-radius: 0;
}

/* QPushButton in nodes - flat style */
QWidget#NodeEmbeddedWidget QPushButton {
    background-color: #005FAC;
    color: #FFFFFF;
    border: none;
    border-radius: 0;
    padding: 2px 8px;
    min-height: 16px;
    max-height: 16px;
    min-width: 40px;
}

QWidget#NodeEmbeddedWidget QPushButton:hover {
    background-color: #107EBC;
}

QWidget#NodeEmbeddedWidget QPushButton:pressed {
    background-color: #003F8C;
}
