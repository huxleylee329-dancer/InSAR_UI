/* Dark theme - comprehensive color overrides - themes/dark.qss */

/* Apply the dark palette to standalone QWidget-based tool windows. */
QWidget:window {
    background-color: #1A1C1C;
    color: #F2F2F2;
}

QMainWindow {
    background-color: #1A1C1C;
}

QTreeView {
    background-color: #2b2b2b;
    color: #FFFFFF;
}

QTreeView::item:selected {
    background-color: #005FAC;
    color: white;
}

QTreeView::item:hover {
    background-color: #404040;
    color: #FFFFFF;
}

QTreeView::item:selected:hover {
    background-color: #004b87;
    color: white;
}

/* TreeView branch indicator styling (Dark Theme) */
QTreeView::branch:has-children:closed:has-siblings,
QTreeView::branch:has-children:closed {
    border-image: none;
    image: url(:/SatExplorer/svg/chevron_right_dark.svg);
}

QTreeView::branch:open:has-children:has-siblings,
QTreeView::branch:open:has-children {
    border-image: none;
    image: url(:/SatExplorer/svg/chevron_down_dark.svg);
}

MainWindow #treeView,
MainWindow #tool {
    background-color: #2b2b2b;
    color: #FFFFFF;
}

QTreeView QHeaderView::section {
    background-color: #404040;
    color: #FFFFFF;
    border: 1px solid #555555;
}

MainWindow #tabWidget {
    background-color: #2b2b2b;
}

MainWindow QTabBar::tab {
    background-color: #404040;
    color: #CCCCCC;
}

MainWindow QTabBar::tab:selected {
    background-color: #2b2b2b;
    color: #FFFFFF;
}

QStatusBar {
    background-color: #2b2b2b;
    border-top: 1px solid #444444;
}

QMenuBar {
    background-color: #2b2b2b;
    border-bottom: 1px solid #444444;
}

QMenuBar::item {
    color: #FFFFFF;
}

QMenuBar::item:disabled {
    color: #7A7A7A;
}

QMenuBar::item:selected:enabled {
    background-color: #005FAC;
    color: white;
}

QMenuBar::item:selected:disabled {
    background-color: transparent;
    color: #7A7A7A;
}

QMenu {
    background-color: #2b2b2b;
    color: #FFFFFF;
    border: 1px solid #444444;
}

QMenu::item {
    color: #FFFFFF;
    padding: 6px 24px 6px 38px;
}

QMenu::item:disabled {
    color: #7A7A7A;
    background-color: transparent;
}

QMenu::item:selected:enabled {
    background-color: #005FAC;
    color: white;
}

QMenu::item:selected:disabled {
    background-color: transparent;
    color: #7A7A7A;
}

QMenu::item:checked {
    background-color: #1b3252;
    color: white;
}

QToolBar {
    background-color: #2b2b2b;
    border-bottom: 1px solid #444444;
}

QToolBar QToolButton {
    color: #FFFFFF;
}

QToolBar QToolButton:disabled {
    color: #7A7A7A;
}

QToolBar QToolButton:hover:enabled {
    color: #FFFFFF;
}

QToolBar QToolButton:hover:disabled {
    color: #7A7A7A;
}

QPushButton {
    background-color: #404040;
    color: #FFFFFF;
    border: 1px solid #666666;
}

QPushButton:hover {
    background-color: #505050;
    border-color: #005FAC;
}

QPushButton:pressed {
    background-color: #303030;
}

QPushButton:disabled {
    background-color: #2b2b2b;
    color: #666666;
}

QPushButton.primary {
    background-color: #005FAC;
    color: white;
    border: none;
}

QPushButton.primary:hover {
    background-color: #2090CC;
}

QPushButton.primary:pressed {
    background-color: #004F9C;
}

QLineEdit {
    background-color: #404040;
    color: #FFFFFF;
    border: 1px solid #666666;
}

QLineEdit:focus {
    border-color: #005FAC;
}

QLineEdit:disabled {
    background-color: #2b2b2b;
    color: #666666;
}

QComboBox {
    background-color: #404040;
    color: #FFFFFF;
    border: 1px solid #666666;
}

QComboBox:hover {
    border-color: #005FAC;
}

QComboBox QAbstractItemView {
    background-color: #404040;
    color: #FFFFFF;
    border: 1px solid #666666;
    selection-background-color: #005FAC;
    selection-color: white;
}

QCheckBox::indicator {
    background-color: #404040;
    border: 1px solid #666666;
}

QCheckBox::indicator:checked {
    background-color: #005FAC;
    border-color: #005FAC;
}

QSpinBox {
    background-color: #404040;
    color: #FFFFFF;
    border: 1px solid #666666;
}

QDoubleSpinBox {
    background-color: #404040;
    color: #FFFFFF;
    border: 1px solid #666666;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    background-color: #505050;
    border: 1px solid #666666;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #505050;
    border: 1px solid #666666;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #606060;
}

QLabel {
    color: #FFFFFF;
}

QTabWidget::pane {
    background-color: #2b2b2b;
    border: 1px solid #444444;
}

QTabBar::tab {
    background-color: #404040;
    color: #CCCCCC;
    border: 1px solid #444444;
}

QTabBar::tab:selected {
    background-color: #2b2b2b;
    color: #FFFFFF;
    border-bottom: 1px solid #2b2b2b;
}

QTabBar::tab:hover:!selected {
    background-color: #505050;
}

QTreeWidget {
    background-color: #2b2b2b;
    color: #FFFFFF;
    border: 1px solid #444444;
}

QTreeWidget::item:selected {
    background-color: #005FAC;
    color: white;
}

QTreeWidget::item:hover {
    background-color: #404040;
}

QListWidget {
    background-color: #2b2b2b;
    color: #FFFFFF;
    border: 1px solid #444444;
}

QListWidget::item:selected {
    background-color: #005FAC;
    color: white;
}

QGroupBox {
    border: 1px solid #444444;
    color: #FFFFFF;
}

QGroupBox::title {
    color: #FFFFFF;
}

QDialog {
    background-color: #1A1C1C;
}

QDialog QLabel, QMessageBox QLabel {
    color: #FFFFFF;
}

QMessageBox {
    background-color: #1A1C1C;
}

ads--CDockWidget {
    background-color: #2b2b2b;
    border: 1px solid #444444;
}

/* ADS dock title bar */
#dockAreaTitleBar {
    background-color: #404040;
}

#autoHideTitleLabel {
    color: #FFFFFF;
}

/* ADS dock close button */
#dockAreaCloseButton {
    background-color: transparent;
    border: none;
    padding: 0px;
    min-width: 16px;
    max-width: 16px;
    min-height: 16px;
    max-height: 16px;
}

#dockAreaCloseButton:hover {
    background-color: #505050;
}

#dockAreaCloseButton QPushButton {
    border: none;
    padding: 0px;
}

#dockAreaCloseButton QPushButton::menu-indicator {
    width: 0px;
}

/* Tab container */
#tabsContainerWidget {
    background-color: #404040;
}

/* Tab label text */
#dockWidgetTabLabel {
    color: #CCCCCC;
}

/* Tab close button */
#tabCloseButton {
    background-color: transparent;
    border: none;
    padding: 0px;
    min-width: 16px;
    max-width: 16px;
    min-height: 16px;
    max-height: 16px;
}

#tabCloseButton:hover {
    background-color: #505050;
}

#tabCloseButton QPushButton::menu-indicator {
    width: 0px;
}

/* ADS title bar buttons (catch-all for all buttons) */
#dockAreaTitleBar QToolButton {
    background: transparent;
    border: none;
    color: #FFFFFF;
}

#dockAreaTitleBar QPushButton {
    background: transparent;
    border: none;
    color: #FFFFFF;
}

/* Tab bar container (CDockWidgetTab inherits QFrame) */
#dockAreaTitleBar QFrame {
    background-color: transparent;
    border: none;
}

#dockAreaTitleBar QFrame QLabel {
    color: #CCCCCC;
}

/* ADS dock area container */
ads--CDockAreaWidget {
    background-color: #2b2b2b;
}

ads--CDockWidget QWidget {
    background-color: #2b2b2b;
}

/* ADS dock area tab bar (when multiple docks in same area) */
ads--CDockAreaWidget QTabBar::tab {
    background-color: #404040;
    color: #CCCCCC;
}

ads--CDockAreaWidget QTabBar::tab:selected {
    background-color: #2b2b2b;
    color: #FFFFFF;
}

ads--CDockAreaWidget QTabBar::tab:hover:!selected {
    background-color: #505050;
}

NodeTreeWidget {
    background-color: #2b2b2b;
    color: #FFFFFF;
    border: 1px solid #444444;
}

PropertyEditor {
    background-color: #2b2b2b;
}

PropertyEditor QLabel {
    color: #FFFFFF;
}

PropertyEditor QLineEdit {
    background-color: #404040;
    color: #FFFFFF;
}

PropertyEditor QDoubleSpinBox {
    background-color: #404040;
    color: #FFFFFF;
}

PropertyEditor QComboBox {
    background-color: #404040;
    color: #FFFFFF;
}

PropertyEditor QSpinBox {
    background-color: #404040;
    color: #FFFFFF;
}

PropertyEditor QCheckBox {
    color: #FFFFFF;
}

PropertyEditor QFrame[frameShape="4"] { /* HLine */
    background-color: #666666;
}

/* Note editor in dark theme */
QTextEdit#noteTextEdit {
    background-color: #1A1C1C;
    color: #FFFFFF;
    border: 1px solid #666666;
    border-radius: 4px;
    padding: 4px;
}



/* Import nodes in dark theme */
/* Node embedded widget (via objectName) - flat style, no background for card layout */
QWidget#NodeEmbeddedWidget {
    background-color: transparent;
}

/* All controls inside node embedded widget - use space descendant selector */
QWidget#NodeEmbeddedWidget QLabel {
    color: #FFFFFF;
}

QWidget#NodeEmbeddedWidget QLabel:disabled {
    color: #666666;
}

QWidget#NodeEmbeddedWidget QLineEdit {
    background-color: #404040;
    color: #FFFFFF;
    border: 1px solid #505050;
    border-radius: 0;
    padding: 2px 5px;
    min-height: 16px;
    max-height: 16px;
}

QWidget#NodeEmbeddedWidget QLineEdit:disabled {
    background-color: #2b2b2b;
    color: #666666;
    border-color: #404040;
}

QWidget#NodeEmbeddedWidget QComboBox {
    background-color: #404040;
    color: #FFFFFF;
    border: 1px solid #505050;
    border-radius: 0;
    padding: 2px 5px;
    min-height: 16px;
    max-height: 16px;
}

QWidget#NodeEmbeddedWidget QComboBox:disabled {
    background-color: #2b2b2b;
    color: #666666;
    border-color: #404040;
}

QWidget#NodeEmbeddedWidget QComboBox QAbstractItemView {
    background-color: #404040;
    color: #FFFFFF;
}

QWidget#NodeEmbeddedWidget QListWidget {
    background-color: #404040;
    color: #FFFFFF;
}

QTableView, QTableWidget {
    background-color: #1F2937;
    color: #F3F4F6;
    gridline-color: #4B5563;
    border: 1px solid #4B5563;
    alternate-background-color: #374151;
}

QTableView::viewport, QTableWidget::viewport {
    background-color: #1F2937;
}

QLabel#NodeStatusLabel {
    color: #9CA3AF;
    font-style: italic;
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: #005FAC;
    color: white;
}

QHeaderView {
    background-color: #111827;
    border: none;
}

QHeaderView::section {
    background-color: #111827;
    color: #D1D5DB;
    border: 1px solid #4B5563;
    padding: 4px;
}

QTableCornerButton::section {
    background-color: #111827;
    border: 1px solid #4B5563;
}

QWidget#NodeEmbeddedWidget QProgressBar {
    background-color: #404040;
    color: #FFFFFF;
    border-radius: 0;
}

/* QPushButton in nodes - flat style */
QWidget#NodeEmbeddedWidget QPushButton {
    background-color: #005FAC;
    color: #FFFFFF;
    border: none;
    border-radius: 0;
    padding: 2px 8px;
    min-height: 16px;
    max-height: 16px;
    min-width: 40px;
}

QWidget#NodeEmbeddedWidget QPushButton:hover {
    background-color: #107EBC;
}

QWidget#NodeEmbeddedWidget QPushButton:pressed {
    background-color: #003F8C;
}

ImportNodeBase QLineEdit {
    background-color: #404040;
    color: #FFFFFF;
}

ImportNodeBase QComboBox {
    background-color: #404040;
    color: #FFFFFF;
}

ImportNodeBase QComboBox QAbstractItemView {
    background-color: #404040;
    color: #FFFFFF;
}

ImportNodeBase QListWidget {
    background-color: #404040;
    color: #FFFFFF;
}

ImportNodeBase QProgressBar {
    background-color: #404040;
    color: #FFFFFF;
}

/* QPushButton in nodes */
ImportNodeBase QPushButton {
    background-color: #404040;
    color: #FFFFFF;
    border: 1px solid #666666;
}

ImportNodeBase QPushButton:hover {
    background-color: #505050;
    border-color: #005FAC;
}
