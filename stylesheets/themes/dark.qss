/* Dark theme - comprehensive color overrides - themes/dark.qss */

QMainWindow {
    background-color: #353535;
}

QStatusBar {
    background-color: #2b2b2b;
    border-top: 1px solid #444444;
}

QMenuBar {
    background-color: #2b2b2b;
    border-bottom: 1px solid #444444;
}

QMenuBar::item {
    color: #FFFFFF;
}

QMenuBar::item:selected {
    background-color: #4a9acf;
    color: white;
}

QToolBar {
    background-color: #2b2b2b;
    border-bottom: 1px solid #444444;
}

QPushButton {
    background-color: #404040;
    color: #FFFFFF;
    border: 1px solid #666666;
}

QPushButton:hover {
    background-color: #505050;
    border-color: #4a9acf;
}

QPushButton:pressed {
    background-color: #303030;
}

QPushButton:disabled {
    background-color: #2b2b2b;
    color: #666666;
}

QPushButton.primary {
    background-color: #4a9acf;
    color: white;
    border: none;
}

QPushButton.primary:hover {
    background-color: #5ab9df;
}

QPushButton.primary:pressed {
    background-color: #3a8abf;
}

QLineEdit {
    background-color: #404040;
    color: #FFFFFF;
    border: 1px solid #666666;
}

QLineEdit:focus {
    border-color: #4a9acf;
}

QLineEdit:disabled {
    background-color: #2b2b2b;
    color: #666666;
}

QComboBox {
    background-color: #404040;
    color: #FFFFFF;
    border: 1px solid #666666;
}

QComboBox:hover {
    border-color: #4a9acf;
}

QComboBox QAbstractItemView {
    background-color: #404040;
    color: #FFFFFF;
    border: 1px solid #666666;
    selection-background-color: #4a9acf;
    selection-color: white;
}

QCheckBox::indicator {
    background-color: #404040;
    border: 1px solid #666666;
}

QCheckBox::indicator:checked {
    background-color: #4a9acf;
    border-color: #4a9acf;
}

QSpinBox {
    background-color: #404040;
    color: #FFFFFF;
    border: 1px solid #666666;
}

QDoubleSpinBox {
    background-color: #404040;
    color: #FFFFFF;
    border: 1px solid #666666;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    background-color: #505050;
    border: 1px solid #666666;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #505050;
    border: 1px solid #666666;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #606060;
}

QLabel {
    color: #FFFFFF;
}

QTabWidget::pane {
    background-color: #2b2b2b;
    border: 1px solid #444444;
}

QTabBar::tab {
    background-color: #404040;
    color: #CCCCCC;
    border: 1px solid #444444;
}

QTabBar::tab:selected {
    background-color: #2b2b2b;
    color: #FFFFFF;
    border-bottom: 1px solid #2b2b2b;
}

QTabBar::tab:hover:!selected {
    background-color: #505050;
}

QTreeWidget {
    background-color: #2b2b2b;
    color: #FFFFFF;
    border: 1px solid #444444;
}

QTreeWidget::item:selected {
    background-color: #4a9acf;
    color: white;
}

QTreeWidget::item:hover {
    background-color: #404040;
}

QListWidget {
    background-color: #2b2b2b;
    color: #FFFFFF;
    border: 1px solid #444444;
}

QListWidget::item:selected {
    background-color: #4a9acf;
    color: white;
}

QGroupBox {
    border: 1px solid #444444;
    color: #FFFFFF;
}

QGroupBox::title {
    color: #FFFFFF;
}

QDialog {
    background-color: #353535;
}

/* Node Editor Dark Theme */
PaletteGraphicsView {
    background-color: #2b2b2b;
}

ads--CDockWidget {
    background-color: #2b2b2b;
    border: 1px solid #444444;
}

ads--CDockWidget #title {
    background-color: #404040;
    color: #FFFFFF;
}

NodeTreeWidget {
    background-color: #2b2b2b;
    color: #FFFFFF;
    border: 1px solid #444444;
}

PropertyEditor {
    background-color: #2b2b2b;
}

PropertyEditor QLineEdit {
    background-color: #404040;
    color: #FFFFFF;
}

/* Source node in dark theme */
QLineEdit#sourceLineEdit {
    background-color: #4a9acf;
    color: white;
    border: 1px solid #5ab9df;
}

QLabel#mathLabel, QLabel#displayLabel {
    background-color: #4a9acf;
    color: white;
    border: 1px solid #5ab9df;
}
